# Telegram Bot Credentials
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram User IDs
WIFE_ID=111111111
MY_ID=222222222

# Часовой пояс задач и напоминаний (по умолчанию UTC+4)
# Поддерживаются форматы: UTC+4, UTC+04:00, +04:00, Asia/Dubai, Europe/Moscow, Europe/Samara и др.
TIMEZONE=UTC+4

# Ollama API Configuration
# Примечание: можно указывать как с /api/generate, так и просто базовый URL хоста
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3.8:27b-mlx
OLLAMA_TIMEOUT_SECONDS=120

# ==============================================================================
# Database Configuration (PostgreSQL / SQLite)
# ==============================================================================
# Тип базы: postgres (по умолчанию в Docker) или sqlite
DB_TYPE=postgres

# Параметры подключения к PostgreSQL (общий сервер для разных проектов)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=family_tasks_bot

# SQLite Database (для обратной совместимости и локальных тестов)
DB_PATH=tasks.db

# Context & Debounce Tuning
DEBOUNCE_DELAY_SECONDS=3.5
CONTEXT_HISTORY_LIMIT=7

# ==============================================================================
# Speech-to-Text (Локальный ASR faster-whisper)
# ==============================================================================
# Включение/отключение обработки голосовых сообщений
ASR_ENABLED=true

# Размер модели Whisper: tiny, base, small, medium, large-v3
ASR_MODEL_SIZE=small

# Устройство инференса: cpu или cuda (при наличии GPU NVIDIA)
ASR_DEVICE=cpu

# Тип квантования: int8 (для CPU), float16 (для GPU), default
ASR_COMPUTE_TYPE=int8

# Язык распознавания по умолчанию
ASR_LANGUAGE=ru

# Параметр лучевого поиска (beam size)
ASR_BEAM_SIZE=5

# Таймаут распознавания в секундах
ASR_TIMEOUT_SECONDS=300

# Максимальный размер входящего голосового файла в МБ
ASR_MAX_FILE_SIZE_MB=30

# ==============================================================================
# Режим резюмирования и хранение аудио
# ==============================================================================
# Режим вывода резюме:
# db_only      - сохранять транскрипцию и резюме только в базе SQLite (жена не видит изменений)
# edit_caption - редактировать подпись оригинального голосового сообщения через Telegram Business API
VOICE_SUMMARY_MODE=db_only

# Сохранять ли аудиофайлы на диске после транскрибации (true/false)
VOICE_KEEP_AUDIO=false

# Каталог для хранения аудиофайлов (если VOICE_KEEP_AUDIO=true)
VOICE_AUDIO_DIR=voice_audio

# ==============================================================================
# Интеграция с Trello (двусторонняя синхронизация задач)
# ==============================================================================
# Включение синхронизации с Trello (true/false, по умолчанию true при наличии ключей)
TRELLO_ENABLED=true

# API Key и API Secret из кабинета разработчика Trello Power-Up Admin:
# https://trello.com/power-ups/admin
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_API_SECRET=your_trello_api_secret_here

# Пользовательский токен авторизации (с правами чтения и записи read,write)
# Получение: https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=YOUR_API_KEY
TRELLO_TOKEN=your_trello_token_here

# ID или короткая ссылка доски Trello (из URL доски https://trello.com/b/BOARD_ID/...)
TRELLO_BOARD_ID=your_trello_board_id_here

# Названия колонок для входящих и завершенных задач (поиск без учета регистра и эмодзи)
# Разделитель настраивается параметром TRELLO_LIST_SEPARATOR (по умолчанию запятая)
TRELLO_LIST_SEPARATOR=,
TRELLO_INBOX_LISTS=Inbox, Входящие, Новые, To Do
TRELLO_DONE_LISTS=Done, Завершено, Выполнено, Готово, Сделано

# Интервал систематического сканирования (polling fallback) в секундах
TRELLO_POLL_INTERVAL_SECONDS=60

# ==============================================================================
# Встроенный Web Server: Web UI, REST API и Callbacks (Trello Webhooks)
# ==============================================================================
# Включение встроенного веб-сервера (по умолчанию true)
WEB_ENABLED=true

# Сетевой хост и порт для веб-сервера
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Префикс маршрутов приложения для изоляции нескольких ботов на одном домене/прокси
# Например: при WEB_PREFIX=/pftb
# - Web UI (морда) доступна по: http://domain:8080/pftb/
# - REST API доступен по: http://domain:8080/pftb/api/v1/...
# - Вебхуки Trello доступны по: http://domain:8080/pftb/trello/webhook
WEB_PREFIX=/pftb

# Встроенный HTTP-сервер для приема вебхуков (callbacks) от Trello
TRELLO_WEBHOOK_ENABLED=true
TRELLO_WEBHOOK_HOST=0.0.0.0
TRELLO_WEBHOOK_PORT=8080
TRELLO_WEBHOOK_PATH=/trello/webhook

# Внешний публичный HTTPS URL вебхука для автоматической регистрации в Trello (опционально, например через ngrok или свой домен)
# Если не указан, синхронизация завершенных задач надежно работает через систематическое сканирование (polling fallback)
TRELLO_WEBHOOK_CALLBACK_URL=

# ==============================================================================
# Интеграция с Apple Calendar через CalDAV
# ==============================================================================
# Включение создания событий в календаре Apple (true/false)
CALDAV_ENABLED=false

# URL CalDAV сервера (для Apple iCloud используется https://caldav.icloud.com/)
CALDAV_URL=https://caldav.icloud.com/

# Учетная запись Apple ID / CalDAV (например, user@icloud.com)
CALDAV_USERNAME=your_apple_id_here

# Пароль приложения (App-Specific Password, генерируется на appleid.apple.com)
CALDAV_PASSWORD=your_app_specific_password_here

# Название календаря по умолчанию (если пусто, выбирается первый доступный календарь)
CALDAV_CALENDAR_NAME=Personal

# ==============================================================================
# Локальный Vision Intelligence (анализ фото через Ollama и вложения в Trello)
# ==============================================================================
# Включение/отключение обработки фотографий (true/false)
VISION_ENABLED=true

# Провайдер локального Vision (поддерживается только локальный ollama)
VISION_PROVIDER=ollama

# Модель Vision в локальном Ollama (рекомендуется qwen3-vl:32b для Mac Studio)
# Установка вручную: ollama pull qwen3-vl:32b
VISION_MODEL=qwen3-vl:32b

# Базовый URL локального Ollama (по умолчанию берется из OLLAMA_URL)
VISION_BASE_URL=http://127.0.0.1:11434

# Таймаут Vision-инференса в секундах
VISION_TIMEOUT_SECONDS=120

# Ограничения на размер и количество изображений
VISION_MAX_IMAGE_SIZE_MB=20
VISION_MAX_IMAGES_PER_MESSAGE=10
VISION_MAX_ALBUM_SIZE=10
VISION_ALBUM_WAIT_SECONDS=1.5

# Ограничение одновременных запросов к Vision-модели (консервативное значение по умолчанию: 1)
VISION_MAX_CONCURRENT_REQUESTS=1

# Временное хранилище и политика хранения (файлы удаляются после обработки/прикрепления)
VISION_TEMP_DIR=/tmp/personalfamilytasksbot/vision
VISION_KEEP_LOCAL_FILES=false
VISION_TEMP_FILE_TTL_MINUTES=60

# Интеграция с Trello и контекстом диалога
VISION_ATTACH_TO_TRELLO=true
VISION_ADD_DESCRIPTION_TO_TASK=true
VISION_CONTEXT_ENABLED=true
VISION_OCR_ENABLED=true

# Политика повторов при временных сбоях Ollama / Trello
VISION_RETRY_MAX_ATTEMPTS=3
VISION_RETRY_BASE_DELAY_SECONDS=2
VISION_ATTACHMENT_RETRY_INTERVAL_SECONDS=120
VISION_CLEANUP_INTERVAL_MINUTES=15
